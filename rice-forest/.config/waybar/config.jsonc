// -*- mode: jsonc -*-
// Forest pastel Minimalist Rice - Waybar Config (continuous top bar)
{
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "margin-bottom": 0,
    "spacing": 0,
    
    // Left bar: Workspaces
    "modules-left": [
        "hyprland/workspaces"
    ],
    
    // Center bar: Active media
    "modules-center": [
        "custom/media"
    ],
    
    // Right bar: All status info in one group
    "modules-right": [
        "cpu",
        "memory",
        "temperature",
        "backlight",
        "pulseaudio",
        "network",
        "battery",
        "clock"
    ],
    
    // === MODULE CONFIGURATIONS ===
    
    // Center: Workspace bubbles
    // Note: Window icons clutter the bar - keeping it minimal with numbers only
    "hyprland/workspaces": {
        "format": "{name}",
        "disable-scroll": false,
        "all-outputs": true,
        "active-only": false,
        "on-click": "activate",
        "persistent-workspaces": {
            "*": 3
        }
    },

    "custom/media": {
        "exec": "~/.config/waybar/media-status.sh",
        "return-type": "json",
        "interval": 1,
        "on-click": "playerctl play-pause",
        "on-click-middle": "playerctl previous",
        "on-click-right": "playerctl next",
        "escape": false
    },
    
    // Right: System info modules
    "cpu": {
        "interval": 2,
        "format": "󰍛 {usage}%",
        "tooltip": false
    },
    
    "memory": {
        "interval": 2,
        "format": " {percentage}%",
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G used"
    },
    
    "temperature": {
        "critical-threshold": 80,
        "interval": 2,
        "format": "{icon} {temperatureC}°",
        "format-critical": "{icon} {temperatureC}°",
        "format-icons": ["", "", "", "", ""]
    },
    
    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["", "", "", "", "", "", "", "", ""],
        "tooltip": false
    },
    
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "{icon} {volume}%",
        "format-bluetooth-muted": "󰝟 {volume}%",
        "format-muted": "󰝟 {volume}%",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "󰋎",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol",
        "tooltip": false
    },
    
    "network": {
        "interval": 3,
        "format-wifi": "󰖩 {signalStrength}%",
        "format-ethernet": "󰈀 Connected",
        "format-linked": "󰈀 No IP",
        "format-disconnected": "󰖪 Disc",
        "tooltip-format": "{essid} ({signalStrength}%)\n{ipaddr}/{cidr}",
        "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}",
        "tooltip-format-disconnected": "Disconnected"
    },
    
    "battery": {
        "interval": 10,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-full": "{icon} {capacity}%",
        "format-charging": "󱐋 {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },
    
    "clock": {
        "timezone": "America/Chicago",
        "format": "{:%I:%M %p}",
        "format-alt": "{:%a, %d %b}",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>"
    }
}
