# Work: SMC Perry dock, laptop panel off
profile perry {
    output eDP-1 disable
    output "Dell Inc. DELL P2422H 65XK0K3" enable mode 1920x1080 position 0,0    scale 1
    output "Dell Inc. DELL P2422H HN800K3" enable mode 1920x1080 position 1920,0 scale 1
    output "Dell Inc. DELL P2422H 31NY9J3" enable mode 1920x1080 position 3840,0 scale 1
}

profile SMCMain {
    output "Dell Inc. DELL P2422H 1B7LQP3" enable mode 1920x1080 position 0,0 scale 1
    output "Dell Inc. DELL P2422H 1JKWZJ3" enable mode 1920x1080 position 1920,0 scale 1
    output eDP-1 disable
}

profile SMCMain-with-Vertical {
    output "Dell Inc. DELL P2422H 1B7LQP3" enable mode 1920x1080 position 0,0 scale 1
    output "Dell Inc. DELL P2422H 1JKWZJ3" enable mode 1920x1080 position 1920,0 scale 1
    output "Dell Inc. DELL P2419H VJT1P9921Q6B" enable mode 1920x1080 position 3840,-310 scale 1 transform 270
    output eDP-1 disable
}

# Laptop only
profile undocked {
    output eDP-1 enable mode 1920x1080@60 scale 1.2
}
