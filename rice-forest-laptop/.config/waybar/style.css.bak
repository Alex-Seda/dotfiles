/* Arctic-blue Minimalist Rice - Waybar GTK CSS */

/* === COLOR DEFINITIONS === */
@define-color arctic-primary #6DD3CE;
@define-color arctic-secondary #4FACB0;
@define-color arctic-dark #2A3F4F;
@define-color arctic-darker #1A2530;

@define-color earth-warm #C98474;
@define-color earth-muted #8B7E74;

@define-color bg-primary #0C1821;
@define-color bg-secondary #162633;

@define-color text-primary #E8F4F2;
@define-color text-muted #9BAFB8;

@define-color warning #FFA559;
@define-color critical #FF6B6B;
@define-color success #6DD3CE;

/* === GLOBAL STYLES === */
* {
    border: none;
    border-radius: 0;
    font-family: "JetBrainsMono Nerd Font", "Font Awesome 6", "Symbols Nerd Font Mono", monospace;
    font-size: 13px;
    font-weight: 500;
    min-height: 0;
}

/* === WAYBAR WINDOW === */
window#waybar {
    background-color: transparent;
    color: @text-primary;
}

/* === TOOLTIP === */
tooltip {
    background: alpha(@bg-primary, 0.95);
    border: 1px solid alpha(@arctic-primary, 0.3);
    border-radius: 12px;
    padding: 8px 12px;
    color: @text-primary;
}

tooltip label {
    color: @text-primary;
}

/* === MODULE BASE STYLING === */
#workspaces {
    background: alpha(@bg-primary, 0.75);
    border-radius: 20px;
    padding: 4px 16px;
    margin: 0px 0px;
    border: 1px solid alpha(@arctic-primary, 0.15);
}

/* Status modules container - grouped together */
#cpu,
#memory,
#temperature,
#backlight,
#pulseaudio,
#network,
#battery,
#clock {
    background: transparent;
    padding: 0px 10px;
    margin: 0px 0px;
    border: none;
    box-shadow: none;
}

/* === LEFT BAR: WORKSPACES === */
#workspaces {
    padding: 2px 8px;
    border-radius: 24px;
    margin-right: 16px;
}

#workspaces button {
    padding: 4px 12px;
    margin: 2px 4px;
    background-color: transparent;
    color: @text-muted;
    border: none;
    border-radius: 16px;
    transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
}

#workspaces button:hover {
    background-color: alpha(@arctic-primary, 0.12);
    color: @arctic-primary;
    box-shadow: none;
}

#workspaces button.active {
    background-color: @arctic-primary;
    color: @bg-primary;
    font-weight: 600;
    box-shadow: 0 2px 8px alpha(@arctic-primary, 0.4);
}

#workspaces button.urgent {
    background-color: @critical;
    color: @text-primary;
    animation: urgent-blink 1s ease-in-out infinite alternate;
}

@keyframes urgent-blink {
    to {
        background-color: @warning;
    }
}

/* === RIGHT BAR: STATUS GROUP === */
/* Create a unified background for all right modules */
window#waybar #cpu {
    background: alpha(@bg-primary, 0.75);
    border: 1px solid alpha(@arctic-primary, 0.15);
    border-radius: 24px 0px 0px 24px;
    padding-left: 16px;
    border-right: transparent;
}

window#waybar #clock {
    background: alpha(@bg-primary, 0.75);
    border-top: 1px solid alpha(@arctic-primary, 0.15);
    border-right: 1px solid alpha(@arctic-primary, 0.15);
    border-bottom: 1px solid alpha(@arctic-primary, 0.15);
    border-radius: 0px 24px 24px 0px;
    padding-right: 16px;
    font-weight: 600;
}

window#waybar #memory,
window#waybar #temperature,
window#waybar #backlight,
window#waybar #pulseaudio,
window#waybar #network,
window#waybar #battery {
    background: alpha(@bg-primary, 0.75);
    border-top: 1px solid alpha(@arctic-primary, 0.15);
    border-bottom: 1px solid alpha(@arctic-primary, 0.15);
}

/* Individual module colors */
#cpu {
    color: @arctic-primary;
}

#memory {
    color: @arctic-primary;
}

#temperature {
    color: @arctic-primary;
}

#backlight {
    color: @arctic-primary;
}

#pulseaudio {
    color: @arctic-primary;
}

#pulseaudio.muted {
    color: @arctic-primary;
}

#network {
    color: @success;
}

#network.disconnected {
    color: @critical;
}

#battery {
    color: @success;
}

#battery.charging {
    color: @arctic-primary;
}

#battery.warning:not(.charging) {
    color: @warning;
}

#battery.critical:not(.charging) {
    color: @critical;
}

#clock {
    color: @arctic-primary;
}
